# Optional settings. Copy this file to .env to use them (.env is ignored by git).
# The toolbox runs without any of them.

# Transcription on an AMD GPU (see docker-compose.amd-gpu.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.amd-gpu.yml
# VIDEO_GID=44
# RENDER_GID=993

# A web page on your own network that the watcher reads with fetch_page and with
# the browser, so a broken path to your network shows up in toolbox_status.
# The default is the toolbox's own Stirling-PDF page. LAN_CHECK_TEXT is a few
# words that the page always shows.
# LAN_CHECK_URL=http://192.168.1.10:8085/
# LAN_CHECK_TEXT=No files yet

# SearXNG signs its internal links with this key. Use any random string, for
# example the output of: openssl rand -hex 32
# SEARXNG_SECRET=
