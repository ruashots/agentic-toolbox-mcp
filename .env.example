# Optional settings. Copy this file to .env to use them (.env is ignored by git).
# The toolbox runs without any of them.

# Transcription on an AMD GPU (see docker-compose.amd-gpu.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.amd-gpu.yml
# VIDEO_GID=44
# RENDER_GID=993

# SearXNG signs its internal links with this key. Use any random string, for
# example the output of: openssl rand -hex 32
# SEARXNG_SECRET=
